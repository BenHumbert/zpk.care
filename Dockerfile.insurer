# zkTrident Insurer Nautilus Node
#
# Runs the insurer entity node: formulary publishing, enrollment processing,
# reporting, audit, and admin operations. No wallet, no ZK compilation.
#
# Build:  docker build -f Dockerfile.insurer -t zktrident-insurer .
# Run:    docker run -p 4004:4004 -e ZKTRIDENT_ADMIN_TOKEN=secret zktrident-insurer

FROM node:20-slim

WORKDIR /app

COPY package*.json ./
RUN npm install --ignore-scripts --omit=dev

COPY tsconfig.json ./
COPY src/ ./src/

# State directory for encrypted local state
RUN mkdir -p /data/nautilus-data

# Run as non-root user for security
RUN groupadd -r zktrident && useradd -r -g zktrident zktrident \
    && chown -R zktrident:zktrident /app /data
USER zktrident

EXPOSE 4004

ENV ZKTRIDENT_PORT=4004
ENV ZKTRIDENT_HOST=0.0.0.0
ENV ZKTRIDENT_STATE_DIR=/data/nautilus-data

CMD ["npx", "tsx", "src/nodes/start-insurer-nautilus.ts"]
