# zkTrident Proof Delegate Server
#
# Compiles StateTransitionProgram once at startup, then serves
# proof generation requests from entity nodes over HTTP.
# Only receives hashed Field values — no PHI/PII exposure.
#
# Build:  docker build -f Dockerfile.prover -t zktrident-prover .
# Run:    docker run -p 4040:4040 -e NODE_OPTIONS=--max-old-space-size=6000 zktrident-prover

FROM node:20-slim

WORKDIR /app

COPY package*.json ./
RUN npm install --ignore-scripts --omit=dev

COPY tsconfig.json ./
COPY src/ ./src/

# Run as non-root user for security
RUN groupadd -r zktrident && useradd -r -g zktrident zktrident \
    && chown -R zktrident:zktrident /app
USER zktrident

EXPOSE 4040

ENV ZKTRIDENT_PROVER_PORT=4040
ENV NODE_OPTIONS=--max-old-space-size=6000

CMD ["npx", "tsx", "src/nodes/start-prover.ts"]
