{
  "name": "zpk_care",
  "version": "1.0.0",
  "description": "Zero Knowledge Proof Claim Adjudication on MINA Protocol",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "build": "tsc",
    "test": "npx jest --verbose",
    "start:leviathan": "npx tsx src/nodes/start-leviathan.ts",
    "start:nautilus": "npx tsx src/nodes/start-nautilus.ts",
    "start:prover": "npx tsx src/nodes/start-prover.ts",
    "start:member": "npx tsx src/nodes/start-member-nautilus.ts",
    "start:prescriber": "npx tsx src/nodes/start-prescriber-nautilus.ts",
    "start:pharmacy": "npx tsx src/nodes/start-pharmacy-nautilus.ts",
    "start:insurer": "npx tsx src/nodes/start-insurer-nautilus.ts",
    "start:employer": "npx tsx src/nodes/start-employer-nautilus.ts",
    "fetch:nadac": "npx tsx scripts/fetch-nadac.ts",
    "start:poc": "npx tsx src/poc/poc-orchestrator.ts",
    "start:flowchart": "npx tsx visualizer/demo/flowchart-orchestrator.ts",
    "kill:ports": "node -e \"const{execSync:x}=require('child_process');[3030,8080,3001,3002,3003,3004].forEach(p=>{try{const o=x('netstat -ano',{encoding:'utf8'});const m=o.split('\\n').find(l=>l.includes(':'+p+' ')&&l.includes('LISTEN'));if(m){const pid=m.trim().split(/\\s+/).pop();if(pid&&pid!=='0'){console.log('Killing PID '+pid+' on port '+p);x('taskkill /F /PID '+pid)}}}catch{}});console.log('Done.')\"",
    "start:flowchart:clean": "npm run kill:ports && npx tsx visualizer/demo/flowchart-orchestrator.ts",
    "start:patent-studio": "npx tsx patent-studio/server.ts"
  },
  "keywords": [
    "zkp",
    "mina",
    "healthcare",
    "nft",
    "o1js"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "docx": "^9.5.3",
    "o1js": "^2.13.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.1",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
